# --- LLM routing: LangChain ChatOpenAI -> Portkey Cloud -> OpenRouter (:free models) ---
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key
PORTKEY_API_KEY=your-portkey-api-key
# Portkey provider slug created under Model Catalog -> Add Provider -> OpenRouter
PORTKEY_PROVIDER=@openrouter

# --- Observability: LangSmith tracing (free tier) ---
LANGSMITH_API_KEY=lsv2_your-langsmith-key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=defence-rag

# --- OpenRouter model selection (verify :free availability via GET /models) ---
PRIMARY_MODEL=nvidia/nemotron-3-super-120b-a12b:free
FALLBACK_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# --- Embeddings (local, no API keys) ---
EMBED_MODEL=BAAI/bge-small-en-v1.5
SPARSE_EMBED_MODEL=prithivida/Splade_PP_en_v1

# --- Vector store ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=defence_kb
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4

# --- Agent behaviour ---
MAX_ITERATIONS=3

# --- API ---
# Random fixed value so JWT-ish auth isn't a thing; use any string as a bearer pre-shared key (optional).
API_KEY=